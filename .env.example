# Local SQLite path (relative to project root)
DATABASE_PATH=./data/india.db

# When we move to Postgres on Supabase, set this and we flip the driver:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Free AI providers — optional. Dashboard works without them.
# Get a free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=
# Get a free HuggingFace token: https://huggingface.co/settings/tokens
HF_API_KEY=
