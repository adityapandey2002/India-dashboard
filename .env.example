# Local SQLite path (relative to project root)
DATABASE_PATH=./data/india.db

# When we move to Postgres on Supabase, set this and we flip the driver:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Free AI providers — optional. Dashboard works without them.
# Get a free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional — pin the chat model. Leave blank to auto-detect from the models your
# key actually serves (recommended: Groq decommissions models, so hardcoding one
# silently breaks every AI feature). List yours: curl https://api.groq.com/openai/v1/models
GROQ_MODEL=
# Get a free HuggingFace token: https://huggingface.co/settings/tokens
HF_API_KEY=
